            <ui:VisualElement name="skill-1-cooldown" class="cooldown-overlay" style="flex-grow: 1; background-color: rgba(245, 245, 245, 0.51); -unity-background-image-tint-color: rgb(255, 255, 255);"/>
        </ui:Button>
        <ui:Button text="" name="skill-2" class="skill-button" style="background-color: rgb(0, 55, 55); background-image: url(&quot;project://database/Assets/Art/Skills/Skill2.jpg?fileID=2800000&amp;guid=f9246ebfce3e2b64e99480cc79692c17&amp;type=3#Skill2&quot;); -unity-background-image-tint-color: rgb(165, 209, 255); -unity-background-scale-mode: scale-and-crop;">
            <ui:VisualElement name="skill-2-cooldown" class="cooldown-overlay" style="flex-grow: 1; background-color: rgba(95, 51, 132, 0.51);"/>
        </ui:Button>
        <ui:Button text="" name="skill-3" class="skill-button" style="background-image: url(&quot;project://database/Assets/Art/Skills/Skill3.jpg?fileID=2800000&amp;guid=aa9ac2bf7f4f83143b2d7880069a4a1a&amp;type=3#Skill3&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(47, 79, 79); -unity-background-scale-mode: scale-and-crop;">
            <ui:VisualElement name="skill-3-cooldown" class="cooldown-overlay" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: flex;"/>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
